# ============================================================
# CAMBORIU ESTUDIANTIL — Variables de Entorno
# ============================================================
# Copiá este archivo como .env.local y completá los valores
# cp .env.example .env.local

# ------------------------------------------------------------
# SUPABASE
# Obtené estos valores en: supabase.com → tu proyecto → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# CLOUDINARY
# Obtené estos valores en: cloudinary.com → Dashboard
# ------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu_api_secret_aqui
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=camboriu_unsigned

# ------------------------------------------------------------
# ADMIN
# Email del administrador principal (para acceso al panel)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@camboriuestudiantil.com

# ------------------------------------------------------------
# ANTHROPIC / CHATBOT
# Clave server-only para el asistente virtual
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------
# WHATSAPP
# Número sin espacios ni +, solo dígitos (ej: 5547992816769)
# ------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=5547992816769

# ------------------------------------------------------------
# GOOGLE ANALYTICS
# ID de medición GA4 (ej: G-XXXXXXXXXX)
# ------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Lectura de informes para el dashboard del administrador.
# Property ID es el identificador numérico de la propiedad, no el ID G-.
GA4_PROPERTY_ID=123456789
GOOGLE_ANALYTICS_CLIENT_EMAIL=analytics-dashboard@tu-proyecto.iam.gserviceaccount.com
GOOGLE_ANALYTICS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# META PIXEL
# ID del pixel de Meta/Facebook (solo números)
# ------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ------------------------------------------------------------
# TIKTOK PIXEL
# ID del pixel de TikTok Ads
# ------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# SITE URL (para Open Graph, PWA manifest, etc.)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://camboriuestudiantil.com
